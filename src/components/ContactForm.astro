---
---

<form
  name="contact"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/contact/thank-you"
  class="space-y-5"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>
      Don't fill this out if you're human: <input name="bot-field" />
    </label>
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="font-heading text-xs uppercase tracking-wide text-ink/70">Name</label>
      <input
        type="text"
        name="name"
        id="name"
        required
        class="mt-1 w-full border border-ink/20 bg-paper px-3 py-2 text-sm focus:border-ink focus:outline-none"
      />
    </div>
    <div>
      <label for="email" class="font-heading text-xs uppercase tracking-wide text-ink/70">Email</label>
      <input
        type="email"
        name="email"
        id="email"
        required
        class="mt-1 w-full border border-ink/20 bg-paper px-3 py-2 text-sm focus:border-ink focus:outline-none"
      />
    </div>
  </div>

  <div>
    <label for="case-type" class="font-heading text-xs uppercase tracking-wide text-ink/70">Type of case</label>
    <select
      name="case-type"
      id="case-type"
      class="mt-1 w-full border border-ink/20 bg-paper px-3 py-2 text-sm focus:border-ink focus:outline-none"
    >
      <option value="">Select one (optional)</option>
      <option value="residential">Residential home</option>
      <option value="business">Business or commercial property</option>
      <option value="historical-site">Historical site</option>
      <option value="personal-experience">Personal experience / consultation</option>
      <option value="other">Other</option>
    </select>
  </div>

  <div>
    <label for="message" class="font-heading text-xs uppercase tracking-wide text-ink/70">Message</label>
    <textarea
      name="message"
      id="message"
      rows="6"
      required
      class="mt-1 w-full border border-ink/20 bg-paper px-3 py-2 text-sm focus:border-ink focus:outline-none"
    ></textarea>
  </div>

  <button
    type="submit"
    class="font-heading bg-ink px-6 py-3 text-sm uppercase tracking-wide text-paper transition-colors hover:bg-ink/80"
  >
    Send message
  </button>
</form>
