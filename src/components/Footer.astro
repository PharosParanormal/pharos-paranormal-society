---
interface Props {
  settings?: {
    email: string;
    phone?: string;
    address: string;
    socialLinks: {
      instagram?: string;
      facebook?: string;
      tiktok?: string;
      youtube?: string;
    };
  };
}
const { settings } = Astro.props;
const year = new Date().getFullYear();

const socials = settings
  ? [
      { key: 'instagram', label: 'Instagram', url: settings.socialLinks.instagram },
      { key: 'facebook', label: 'Facebook', url: settings.socialLinks.facebook },
      { key: 'tiktok', label: 'TikTok', url: settings.socialLinks.tiktok },
      { key: 'youtube', label: 'YouTube', url: settings.socialLinks.youtube },
    ].filter((s) => s.url)
  : [];
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <span class="inline-block rounded bg-paper p-1.5">
          <img src="/images/logo.png" alt="Pharos Paranormal Society" class="h-12 w-12 object-contain" />
        </span>
        <p class="font-heading mt-4 text-sm uppercase tracking-widest">Pharos Paranormal Society</p>
        <p class="mt-2 max-w-xs text-sm text-white/60">
          A light in the dark — investigating the unexplained with care, curiosity, and evidence.
        </p>
      </div>

      <div>
        <p class="font-heading text-sm uppercase tracking-widest text-cream">Contact</p>
        {settings ? (
          <ul class="mt-3 space-y-2 text-sm text-white/70">
            <li><a href={`mailto:${settings.email}`} class="hover:text-cream">{settings.email}</a></li>
            <li>{settings.address}</li>
          </ul>
        ) : null}
      </div>

      <div>
        <p class="font-heading text-sm uppercase tracking-widest text-cream">Follow</p>
        {socials.length > 0 ? (
          <ul class="mt-3 space-y-2 text-sm text-white/70">
            {socials.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:text-cream">{s.label}</a></li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 text-sm text-white/50">Links coming soon.</p>
        )}
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-xs text-white/40">
      Midnight investigations of the Jennie Wade House &amp; Orphanage presented by{' '}
      <a
        href="https://www.gettysburgbattlefieldtours.com/bus-tours/specialty-tours/midnight-investigation-orphanage/"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-2 underline-offset-2 hover:text-white/70"
      >
        Ghostly Images of Gettysburg
      </a>.
    </div>

    <div class="mt-4 border-t border-white/10 pt-6 text-xs text-white/40">
      &copy; {year} Pharos Paranormal Society. All rights reserved.
    </div>
  </div>
</footer>
