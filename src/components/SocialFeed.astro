---
// Follows the client's socials. Instagram/TikTok/Facebook embed widgets normally require
// per-app API keys or SDK setup, which this project intentionally avoids (see README).
// When those keys are added later, swap the fallback grid below for the platform's oEmbed/SDK embed.
interface Props {
  socialLinks: {
    instagram?: string;
    facebook?: string;
    tiktok?: string;
    youtube?: string;
  };
  compact?: boolean;
}
const { socialLinks, compact = false } = Astro.props;

const platforms = [
  {
    key: 'instagram',
    label: 'Instagram',
    url: socialLinks.instagram,
    icon: 'M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465a4.9 4.9 0 0 1 1.772 1.153 4.9 4.9 0 0 1 1.153 1.772c.248.637.415 1.363.465 2.428.05 1.066.06 1.405.06 4.122s-.01 3.056-.06 4.122c-.05 1.065-.217 1.79-.465 2.428a4.9 4.9 0 0 1-1.153 1.772 4.9 4.9 0 0 1-1.772 1.153c-.637.248-1.363.415-2.428.465-1.066.05-1.405.06-4.122.06s-3.056-.01-4.122-.06c-1.065-.05-1.79-.217-2.428-.465a4.9 4.9 0 0 1-1.772-1.153 4.9 4.9 0 0 1-1.153-1.772c-.248-.637-.415-1.363-.465-2.428C2.01 15.056 2 14.717 2 12s.01-3.056.06-4.122c.05-1.065.217-1.79.465-2.428a4.9 4.9 0 0 1 1.153-1.772A4.9 4.9 0 0 1 5.45 2.525c.637-.248 1.363-.415 2.428-.465C8.944 2.01 9.283 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.25a3.25 3.25 0 1 1 0-6.5 3.25 3.25 0 0 1 0 6.5zm5.25-8.85a1.15 1.15 0 1 0 0-2.3 1.15 1.15 0 0 0 0 2.3z',
  },
  {
    key: 'facebook',
    label: 'Facebook',
    url: socialLinks.facebook,
    icon: 'M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H16.7V3.7C16.4 3.65 15.5 3.6 14.4 3.6c-2.3 0-3.9 1.4-3.9 4v2.3H8v3.1h2.5V21h3z',
  },
  {
    key: 'tiktok',
    label: 'TikTok',
    url: socialLinks.tiktok,
    icon: 'M16.6 3h-3.2v12.4a2.9 2.9 0 1 1-2.1-2.8v-3.3a6.2 6.2 0 1 0 5.3 6.1V9.5a7.6 7.6 0 0 0 4.4 1.4V7.7c-1.8 0-3.4-1-4.4-2.3V3z',
  },
  {
    key: 'youtube',
    label: 'YouTube',
    url: socialLinks.youtube,
    icon: 'M21.6 7.2s-.2-1.5-.8-2.1c-.8-.8-1.7-.8-2.1-.9C15.9 4 12 4 12 4h0s-3.9 0-6.7.2c-.4 0-1.3.1-2.1.9-.6.6-.8 2.1-.8 2.1S2.2 9 2.2 10.7v1.6c0 1.7.2 3.5.2 3.5s.2 1.5.8 2.1c.8.8 1.8.8 2.3.9 1.7.1 6.5.2 6.5.2s3.9 0 6.7-.2c.4 0 1.3-.1 2.1-.9.6-.6.8-2.1.8-2.1s.2-1.7.2-3.5v-1.6c0-1.7-.2-3.5-.2-3.5zM9.9 14.6V8.9l5.4 2.9-5.4 2.8z',
  },
];

const active = platforms.filter((p) => p.url);
---

{active.length > 0 ? (
  <div class:list={['grid gap-4', compact ? 'grid-cols-4 sm:grid-cols-4' : 'grid-cols-2 sm:grid-cols-4']}>
    {active.map((p) => (
      <a
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center gap-2 border border-ink/10 bg-paper px-4 py-6 text-center transition-colors hover:border-ink hover:bg-cream/40"
      >
        <svg viewBox="0 0 24 24" class="h-7 w-7 fill-ink" aria-hidden="true">
          <path d={p.icon}></path>
        </svg>
        <span class="font-heading text-xs uppercase tracking-wide">{p.label}</span>
      </a>
    ))}
  </div>
) : (
  <p class="text-sm text-ink/50">Social links coming soon.</p>
)}
