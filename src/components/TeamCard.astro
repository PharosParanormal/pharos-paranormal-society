---
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'team'>;
}
const { member } = Astro.props;
const { name, role, photo, specialties } = member.data;
const { Content } = await member.render();
---

<article class="group flex flex-col overflow-hidden border border-ink/10 bg-paper">
  <div class="aspect-square w-full bg-cream/40">
    {photo ? (
      <img src={photo} alt={name} class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-ink/30">
        <span class="font-heading text-4xl">{name.split(' ').map((n) => n[0]).join('')}</span>
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-heading text-lg">{name}</h3>
    <p class="text-sm uppercase tracking-wide text-ink/50">{role}</p>

    {specialties && specialties.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {specialties.map((s: string) => (
          <li class="border border-ink/15 bg-cream/50 px-2 py-0.5 text-xs text-ink/70">{s}</li>
        ))}
      </ul>
    )}

    <details class="mt-4 group/details">
      <summary class="font-heading cursor-pointer text-sm uppercase tracking-wide text-ink underline decoration-cream decoration-2 underline-offset-4 hover:text-ink/70 [&::-webkit-details-marker]:hidden">
        Read bio
      </summary>
      <div class="prose-sm mt-3 space-y-3 text-sm leading-relaxed text-ink/80">
        <Content />
      </div>
    </details>
  </div>
</article>
