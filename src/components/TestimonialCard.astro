---
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}
const { testimonial } = Astro.props;
const { name, location, quote, rating } = testimonial.data;
---

<figure class="flex h-full flex-col justify-between border border-ink/10 bg-paper p-6">
  {rating && (
    <div class="mb-3 text-cream" aria-label={`${rating} out of 5 stars`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <span class={i < rating ? 'text-ink' : 'text-ink/20'}>&#9733;</span>
      ))}
    </div>
  )}
  <blockquote class="flex-1 text-base leading-relaxed text-ink/85">
    &ldquo;{quote}&rdquo;
  </blockquote>
  <figcaption class="mt-4 border-t border-ink/10 pt-3">
    <p class="font-heading text-sm uppercase tracking-wide">{name}</p>
    {location && <p class="text-xs text-ink/50">{location}</p>}
  </figcaption>
</figure>
