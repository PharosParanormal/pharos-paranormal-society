---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, author, coverImage, tags } = post.data;
const { Content } = await post.render();
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout title={title} description={post.data.excerpt}>
  <article>
    <header class="border-b border-ink/10 bg-ink text-paper">
      <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
        <a href="/blog" class="font-heading text-sm uppercase tracking-wide text-cream hover:text-paper">&larr; Back to blog</a>
        <h1 class="font-heading mt-6 text-3xl leading-tight sm:text-5xl">{title}</h1>
        <p class="mt-5 text-sm text-white/60">{formattedDate} &middot; {author}</p>
      </div>
    </header>

    {coverImage && (
      <div class="mx-auto max-w-4xl px-4 pt-10 sm:px-6">
        <img src={coverImage} alt={title} class="w-full object-cover" />
      </div>
    )}

    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <div class="prose prose-ink max-w-none leading-relaxed text-ink/85 [&_h2]:font-heading [&_h2]:mt-10 [&_h2]:text-2xl [&_p]:mt-4 [&_a]:underline [&_a]:decoration-cream [&_a]:decoration-2 [&_a]:underline-offset-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">
        <Content />
      </div>

      {tags && tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2 border-t border-ink/10 pt-6">
          {tags.map((tag: string) => (
            <span class="border border-ink/15 bg-cream/50 px-2.5 py-1 text-xs uppercase tracking-wide text-ink/70">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </article>
</Layout>
