---
import Layout from '../layouts/Layout.astro';
import SocialFeed from '../components/SocialFeed.astro';
import { getCollection } from 'astro:content';

const settingsEntries = await getCollection('site-settings');
const settings = settingsEntries[0].data;
---

<Layout title="Contact" description="Get in touch with Pharos Paranormal Society.">
  <section class="border-b border-ink/10 bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="font-heading text-sm uppercase tracking-[0.3em] text-cream">Contact</p>
      <h1 class="font-heading mt-4 max-w-2xl text-4xl sm:text-5xl">Let's talk about what you're experiencing</h1>
      <p class="mt-5 max-w-xl text-white/70">{settings.investigationRequestNote}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="flex flex-col items-start border border-ink/10 bg-cream/30 p-8">
        <p class="font-heading text-sm uppercase tracking-widest text-ink/60">Get in touch</p>
        <p class="mt-3 text-ink/80">
          The fastest way to reach us is by email. Tell us about your location and what you've been experiencing, and we'll follow up within a few days.
        </p>
        <a
          href={`mailto:${settings.email}`}
          class="font-heading mt-6 inline-block bg-ink px-8 py-3 text-sm uppercase tracking-wide text-paper transition-colors hover:bg-ink/80"
        >
          {settings.email}
        </a>
        <p class="mt-6 text-sm text-ink/60">{settings.address}</p>
      </div>

      <div>
        <p class="font-heading text-sm uppercase tracking-widest text-ink/60">Follow us</p>
        <div class="mt-4">
          <SocialFeed socialLinks={settings.socialLinks} />
        </div>
      </div>
    </div>
  </section>
</Layout>
