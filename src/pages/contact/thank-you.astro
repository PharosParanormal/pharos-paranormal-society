---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Thank You" description="Thanks for reaching out to Pharos Paranormal Society.">
  <section class="mx-auto flex max-w-2xl flex-col items-start px-4 py-32 sm:px-6">
    <p class="font-heading text-sm uppercase tracking-[0.3em] text-ink/50">Message sent</p>
    <h1 class="font-heading mt-4 text-4xl">Thank you.</h1>
    <p class="mt-5 text-base leading-relaxed text-ink/75">
      We've received your message and will follow up within a few days. Every request is reviewed personally, and all investigations remain confidential.
    </p>
    <a
      href="/"
      class="font-heading mt-8 inline-block bg-ink px-6 py-3 text-sm uppercase tracking-wide text-paper transition-colors hover:bg-ink/80"
    >
      Back to home
    </a>
  </section>
</Layout>
