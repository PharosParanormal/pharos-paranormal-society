---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Thank You" description="Thanks for reaching out to Pharos Paranormal Society.">
  <section class="border-b border-ink/10 bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="font-heading text-sm uppercase tracking-[0.3em] text-cream">Contact</p>
      <h1 class="font-heading mt-4 max-w-2xl text-4xl sm:text-5xl">Thank you — we've got it.</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-xl border border-ink/10 bg-cream/30 p-8">
      <p class="text-ink/80">
        Your request has been sent to our team. We review every case personally and will follow up within a few days.
      </p>
      <a
        href="/"
        class="font-heading mt-6 inline-block bg-ink px-8 py-3 text-sm uppercase tracking-wide text-paper transition-colors hover:bg-ink/80"
      >
        Back to home
      </a>
    </div>
  </section>
</Layout>
