---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Video Evidence" description="Video evidence captured by Pharos Paranormal Society." noindex>
  <section class="flex min-h-[70vh] items-center bg-ink text-paper">
    <div class="mx-auto w-full max-w-2xl px-4 py-20 text-center sm:px-6">
      <p class="font-heading text-sm uppercase tracking-[0.3em] text-cream">Evidence</p>
      <h1 class="font-heading mt-4 text-4xl sm:text-5xl">Listen closely</h1>
      <p class="mx-auto mt-5 max-w-md text-white/70">
        This footage was captured during one of our investigations. Turn the sound up or put on headphones.
      </p>
      <div class="mx-auto mt-8 max-w-md rounded-lg border border-cream/40 px-5 py-4 text-left">
        <p class="font-heading text-xs uppercase tracking-widest text-cream">What to listen for</p>
        <p class="mt-2 text-white/80">
          Listen for <span class="font-semibold text-paper">humming</span> and <span class="font-semibold text-paper">knocks</span>.
        </p>
      </div>
      <video
        class="mx-auto mt-10 w-full max-w-xl rounded-lg bg-black"
        controls
        playsinline
        preload="metadata"
        src="/video/humming-knocks.mp4"
      >
        Your browser can't play this video. <a class="underline" href="/video/humming-knocks.mp4">Download the clip</a>.
      </video>
    </div>
  </section>
</Layout>
