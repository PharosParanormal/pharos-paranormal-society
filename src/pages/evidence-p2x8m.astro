---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Video Evidence" description="Video evidence captured by Pharos Paranormal Society." noindex>
  <section class="flex min-h-[70vh] items-center bg-ink text-paper">
    <div class="mx-auto w-full max-w-2xl px-4 py-20 text-center sm:px-6">
      <p class="font-heading text-sm uppercase tracking-[0.3em] text-cream">Evidence</p>
      <h1 class="font-heading mt-4 text-4xl sm:text-5xl">Listen closely</h1>
      <p class="mx-auto mt-5 max-w-md text-white/70">
        This footage was captured during one of our investigations. Turn the sound up or put on headphones.
      </p>
      <video
        class="mx-auto mt-10 w-full rounded-lg bg-black"
        controls
        playsinline
        preload="metadata"
        src="/video/evidence-p2x8m.mp4"
      >
        Your browser can't play this video. <a class="underline" href="/video/evidence-p2x8m.mp4">Download the clip</a>.
      </video>
    </div>
  </section>
</Layout>
