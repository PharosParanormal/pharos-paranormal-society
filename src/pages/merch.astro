---
import Layout from '../layouts/Layout.astro';
import SocialFeed from '../components/SocialFeed.astro';
import { getCollection } from 'astro:content';

const settingsEntries = await getCollection('site-settings');
const settings = settingsEntries[0].data;

const products = [
  {
    category: 'Book',
    title: 'The Bright Light',
    subtitle: 'What We Found at the Haunted Orphanage and Jennie Wade House',
    author: 'Nicole Smith-Merry, MS, LPC, NCC',
    image: '/images/merch/The_Bright_Light_Nicole_Smith-Merry.jpg',
    description:
      "Our own Nicole takes you inside two of Gettysburg's most famous haunted sites, the National Soldiers' Orphans Homestead and the Jennie Wade House, and shares what she found there.",
    href: 'https://a.co/d/0hC3Ri4W',
    cta: 'Buy on Amazon',
  },
];
---

<Layout title="Merch" description="Shop Pharos Paranormal Society merch, including The Bright Light by team member Nicole Smith-Merry.">
  <section class="border-b border-ink/10 bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="font-heading text-sm uppercase tracking-[0.3em] text-cream">Merch</p>
      <h1 class="font-heading mt-4 max-w-2xl text-4xl sm:text-5xl">The Pharos shop</h1>
      <p class="mt-5 max-w-xl text-white/70">
        Books, gear, and more from the Pharos Paranormal Society team. We're starting with a book from one of our own, and tees and hats are on the way.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    {products.map((product) => (
      <article class="grid items-center gap-10 border border-ink/10 bg-paper p-6 sm:p-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <a href={product.href} target="_blank" rel="noopener noreferrer" class="mx-auto block w-full max-w-xs">
          <img
            src={product.image}
            alt={`${product.title} book cover`}
            class="w-full shadow-xl transition-transform duration-300 hover:scale-[1.02]"
            loading="lazy"
          />
        </a>
        <div>
          <p class="font-heading text-sm uppercase tracking-widest text-ink/50">{product.category}</p>
          <h2 class="font-heading mt-3 text-3xl sm:text-4xl">{product.title}</h2>
          <p class="mt-2 text-lg text-ink/80">{product.subtitle}</p>
          <p class="mt-4 text-sm uppercase tracking-wide text-ink/60">By {product.author}</p>
          <p class="mt-6 max-w-xl text-ink/70">{product.description}</p>
          <a
            href={product.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-heading mt-8 inline-block bg-ink px-8 py-3 text-sm uppercase tracking-wide text-paper transition-colors hover:bg-ink/80"
          >
            {product.cta} &rarr;
          </a>
        </div>
      </article>
    ))}
  </section>

  <section class="border-t border-ink/10 bg-cream/40">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6">
      <p class="font-heading text-sm uppercase tracking-widest text-ink/50">More on the way</p>
      <h2 class="font-heading mt-3 text-2xl">Follow along for new drops</h2>
      <p class="mx-auto mt-4 max-w-md text-ink/70">
        We'll post when new merch lands. Give us a follow so you don't miss it.
      </p>
      <div class="mx-auto mt-8 max-w-xl">
        <SocialFeed socialLinks={settings.socialLinks} />
      </div>
    </div>
  </section>
</Layout>
